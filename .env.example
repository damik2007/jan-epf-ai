# Jan-EPF AI - Environment Configuration Template
APP_NAME="Jan-EPF AI"
ENVIRONMENT="development"
DEBUG=true

# Authentication & Security Keys
JWT_SECRET_KEY="generate-secure-64-byte-hex-key"
JWT_ALGORITHM="HS256"
INTERNAL_SERVICE_SECRET="sec_epf_internal_template"
WEBHOOK_HMAC_SECRET="hmac_npci_callback_template"

# Database & Cache
DATABASE_URL="postgresql://epf_user:epf_password@localhost:5432/epf_master_db"
REDIS_URL="redis://localhost:6379/0"

# Optional Cloud Enhancements (Leave blank for 100% In-Browser Sovereign Local Mode)
OPENAI_API_KEY=""

# Deployment & Integrations
GITHUB_TOKEN=""
VERCEL_TOKEN=""
NEXT_PUBLIC_API_URL="http://localhost:8000"

# Open-Source AI Endpoints
PRESIDIO_ANALYZER_URL="http://localhost:8080"
PADDLE_OCR_URL="http://localhost:8001"
FASTER_WHISPER_URL="http://localhost:8000"
